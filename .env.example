# Cyclone Sentinel AI - Example Configuration
PROJECT_NAME="Cyclone Sentinel AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Auth
SECRET_KEY="cyclone-sentinel-dev-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL="sqlite:///./cyclone_sentinel.db"

# Google AI / Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Google Earth Engine
GEE_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Disaster Sentinel Guardrail Limits
MAX_AGENT_ITERATIONS=5
MIN_CONFIDENCE_THRESHOLD=0.65
REQUIRE_HUMAN_APPROVAL_FOR_ADVISORIES=True
